# Preencher quando o projeto Supabase for criado (Fase 1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servidor — nunca expor com prefixo NEXT_PUBLIC_, nunca commitar.
# Usada só pela "Minha conta" (src/lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Assina o cookie de sessão do cliente na "Minha conta" (32+ caracteres aleatórios).
CLIENT_SESSION_SECRET=

# Opcional, SÓ com o banco local de teste: mostra o código de acesso da "Minha conta" na tela,
# já que ainda não há envio por WhatsApp (src/lib/client-auth.ts)
# CLIENT_LOGIN_DEMO=true

# Opcional, SÓ com o banco local de teste: desativa o login do painel (src/lib/admin-login-bypass.ts)
# ADMIN_LOGIN_DISABLED=true
# ADMIN_TEST_EMAIL=admin@teste.local
# ADMIN_TEST_PASSWORD=senha-local-de-teste
