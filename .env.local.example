# Preencher quando o projeto Supabase for criado (Fase 1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servidor — nunca expor com prefixo NEXT_PUBLIC_, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional, SÓ com o banco local de teste: desativa o login do painel (src/lib/admin-login-bypass.ts)
# ADMIN_LOGIN_DISABLED=true
# ADMIN_TEST_EMAIL=admin@teste.local
# ADMIN_TEST_PASSWORD=senha-local-de-teste
